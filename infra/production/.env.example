# Copy to .env in this directory. Keep this file private and backed up encrypted.
WEB_HOST=school.example.org
# Use URL-safe characters (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=
PDS_URL=https://neutral-identity.example.net
PDS_HANDLE_DOMAIN=neutral-identity.example.net
PDS_ADMIN_PASSWORD=
SCHOOL_DID=
SCHOOL_HANDLE=
SCHOOL_APP_PASSWORD=
# Founding record values. Set these before running create-school.
SCHOOL_NAME=
SCHOOL_REGION=
SCHOOL_EMAIL=
SESSION_SECRET=
CUSTODY_KEYS=
CUSTODY_KEY_VERSION=v1
FEEDBACK_BALLOT_PEPPER=
OAUTH_PRIVATE_JWK=
SMTP_URL=
MAIL_FROM=Free School <hello@school.example.org>
PEER_PDS_HOSTS=https://neutral-identity.example.net
CONTRAIL_NAMESPACE=org.freeschool.appview
CONTRAIL_ORDERED_SOURCE_EPOCH=freeschool-production-1
CONTRAIL_LIVE_INGEST=false
PEER_LIVE_SYNC=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@school.example.org
