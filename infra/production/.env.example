# Free School production env. Copy to infra/production/.env, chmod 600, fill in, never commit.
# compose.yml reads the ${...} values; the AppView container gets the whole file as env_file.

# ── Hostnames ─────────────────────────────────────────────────────────────────
# The PWA + API origin. This does NOT move: the apex stays Boulder's app (ruling 2).
WEB_HOST=freeskool.xyz
# The PDS hostname. R9 asks for a NEUTRAL name — one that does not say "free school" and
# so does not put a member's community into a world-readable DID document. Benjamin
# registered `freeskool.directory` on 2026-09-14 (federation design §2, ruling 3); the
# migration from `pds.freeskool.xyz` is docs/runbooks/pds-hostname-migration.md.
PDS_HOST=pds.freeskool.directory
# Handles are minted as <name>.<this>, no leading dot. DNS needs `*.<this>` → the server.
PDS_HANDLE_DOMAIN=freeskool.directory
# Every handle domain the PDS answers for, csv. PDS_HANDLE_DOMAIN is always included;
# only needed when this deployment serves more than PDS_HANDLE_DOMAIN and
# PDS_LEGACY_HANDLE_DOMAIN at once. Empty by default.
PDS_HANDLE_DOMAINS=

# ── Hostname migration overlap (EMPTY except during the migration window) ─────
# The names we are moving AWAY from. While these are set, Caddy keeps serving the old PDS
# hostname and the old wildcard, and the PDS keeps accepting handles on both domains — so
# an account whose DID document has not been rewritten yet is still reachable and still
# resolves. Unset them (and redeploy) once `migrate-pds-hostname --apply` reports every
# account verified. See the runbook for the full order, including the rollback.
#
# There is no combination of these to avoid: PDS_HANDLE_DOMAIN, SCHOOL_DOMAIN_SUFFIX and
# PDS_LEGACY_HANDLE_DOMAIN are three addresses on ONE Caddy site block, and Caddy
# deduplicates identical addresses inside a block (it only refuses duplicates ACROSS
# blocks). Equal, all-different, or any mix, the config adapts.
PDS_LEGACY_HOST=
PDS_LEGACY_HANDLE_DOMAIN=

# ── Tributary (sibling stack; /opt/tributary) ─────────────────────────────────
# The events adapter's public host. Caddy serves it from this stack's edge and proxies
# to the `tributary` container on this compose network. Empty = not deployed.
TRIBUTARY_HOST=tributary.freeskool.directory
# Boulder Events Directory: the sibling stack's own domain, PDS and handle domain.
BED_HOST=boulderevents.directory
BED_PDS_HOST=pds.boulderevents.directory
BED_HANDLE_DOMAIN=boulderevents.directory

# ── Postgres (URL-safe characters only: openssl rand -hex 24) ─────────────────
POSTGRES_PASSWORD=

# ── PDS secrets (openssl rand -hex 32 / -hex 16 / see infra/setup-env.sh for the key) ──
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# Leave empty to stay off the Bluesky relay. `https://bsky.network` to announce.
# Empty is a deliberate choice, not a gap to fill in passing — it is Benjamin's call, and
# docs/interop-audit.md gap/open-question 1 is the place that decision is tracked.
PDS_CRAWLERS=
PDS_EMAIL_FROM=no-reply@example.org

# ── The school DID this deployment custodies (printed by create-school) ───────
SCHOOL_DID=
# Ruling 3: the school account's handle moves to the neutral domain, which is what FREES
# `boulder.freeskool.xyz` to be the Boulder city app host (ruling 2). Do not set this back.
SCHOOL_HANDLE=boulder.freeskool.directory
SCHOOL_APP_PASSWORD=
# Founding record values, used only by create-school.
SCHOOL_NAME=Boulder Free School
SCHOOL_REGION=Boulder, CO
SCHOOL_EMAIL=hello@freeskool.xyz
# The domain whose single labels are schools: `<label>.<suffix>` serves that school's app
# and, for the school account, resolves its handle (see docs/deployment.md, "Caddy: handle
# hosts, school hosts, and the on-demand gate"). SCHOOL_LABELS is the list of labels that
# are schools today — it is what the on-demand TLS gate answers from, and what the handle
# namespace reserves, until fs_school_domain replaces it.
# It stays `freeskool.xyz` through the PDS migration and after it: school hosts are WEB
# addresses under the app's apex, and only the PDS and the handles move to the neutral
# domain. `boulder.freeskool.xyz` is a school host here, not a handle, from the moment
# the school account's handle becomes `boulder.freeskool.directory`.
# Caddy needs this one too (compose passes it to the `web` container): `*.<this>` is the
# PERMANENT wildcard, and it is what keeps `boulder.freeskool.xyz` and `www.freeskool.xyz`
# serving after the migration's overlap variables are cleared.
SCHOOL_DOMAIN_SUFFIX=freeskool.xyz
SCHOOL_LABELS=boulder

# ── School creation (MS §8 ruling 1) ────────────────────────────────────────────
# closed|invite|open. Only `closed` is implemented — an operator, holding OPERATOR_TOKEN,
# and nobody else, may create a school; `invite`/`open` answer 501 rather than silently
# reading as closed. There is no self-serve door in this phase (see routes/schools.ts).
SCHOOL_CREATION=closed
# The token an operator presents as `X-Operator-Token` to create a school while
# SCHOOL_CREATION=closed. REQUIRED to ever create a second city; empty refuses
# unconditionally rather than being one blank header away from open creation.
OPERATOR_TOKEN=

# ── Multi-school ─────────────────────────────────────────────────────────────
# `1` turns on host-based tenancy: the Host header names the school, the session carries
# the current one, and a host that names no school is 404 UnknownSchool. Keep it `0` until
# the two-school end-to-end suite is green on this box (federation design ruling 11).
MULTI_SCHOOL=0
# `Domain` on the session cookie. EMPTY = host-only, which is right while the apex is the
# only origin. Set it to `.freeskool.xyz` (leading dot) when cities go live at
# <city>.freeskool.xyz, so one sign-in is one identity across every city. It is only safe
# because every host under the suffix is ours: the reserved-label list in
# apps/appview/src/lib/handles.ts is what stops a member minting the handle `denver` and
# owning a school's origin. Never point it at a domain that serves member content.
# Flipping it needs NO forced sign-out: the AppView migrates each browser's host-only
# cookie to the shared domain on its next request (docs/runbooks/multi-school-rollout.md).
SESSION_COOKIE_DOMAIN=

# ── Taxonomy authority (printed by `seed:skills`; see docs/deployment.md) ─────
# Today these live in /opt/freeskool/infra/production/.authority.env on the server, which
# is NOT read by the appview container — .env is. Add all three here (and recreate the
# appview container) or propose-a-skill answers 503 and the skill tree is unscoped.
# Ruling 3 fixes the authority's handle at `skills.<neutral domain>`; the migration script
# renames it there along with everything else.
AUTHORITY_DID=
AUTHORITY_HANDLE=skills.freeskool.directory
AUTHORITY_PASSWORD=

# ── AppView secrets ───────────────────────────────────────────────────────────
SESSION_SECRET=
CUSTODY_KEYS=v1:
CUSTODY_KEY_VERSION=v1
FEEDBACK_BALLOT_PEPPER=
# Optional. Unset, the AppView generates an ES256 key once and keeps it in Postgres.
OAUTH_PRIVATE_JWK=

# ── Federation / indexing ─────────────────────────────────────────────────────
PEER_PDS_HOSTS=https://pds.freeskool.directory
CONTRAIL_NAMESPACE=org.freeschool.appview
CONTRAIL_ORDERED_SOURCE_EPOCH=freeschool-production-1
CONTRAIL_LIVE_INGEST=false
PEER_LIVE_SYNC=true

# ── Web push (web-push generate-vapid-keys) ───────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.org

# ── Email (REQUIRED in production; the AppView refuses to boot without SMTP_URL) ──
# Resend over SMTP: user `resend`, password = a sending-only API key. Port 2465 (not 465):
# Hetzner Cloud blocks outbound 25/465 on new accounts; Resend also listens on 2465/2587.
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:2465
MAIL_FROM=Free School <hello@example.org>
