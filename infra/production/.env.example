# Free School production env. Copy to infra/production/.env, chmod 600, fill in, never commit.
# compose.yml reads the ${...} values; the AppView container gets the whole file as env_file.

# ── Hostnames ─────────────────────────────────────────────────────────────────
# The PWA + API origin.
WEB_HOST=freeskool.xyz
# The PDS hostname. R9 asks for a NEUTRAL name here (one that does not say "free school");
# this is the decision still open with Benjamin — see docs/deployment.md.
PDS_HOST=pds.freeskool.xyz
# Handles are minted as <name>.<this>, no leading dot. DNS needs `*.<this>` → the server.
PDS_HANDLE_DOMAIN=freeskool.xyz

# ── Postgres (URL-safe characters only: openssl rand -hex 24) ─────────────────
POSTGRES_PASSWORD=

# ── PDS secrets (openssl rand -hex 32 / -hex 16 / see infra/setup-env.sh for the key) ──
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# Leave empty to stay off the Bluesky relay. `https://bsky.network` to announce.
# Empty is a deliberate choice, not a gap to fill in passing — it is Benjamin's call, and
# docs/interop-audit.md gap/open-question 1 is the place that decision is tracked.
PDS_CRAWLERS=
PDS_EMAIL_FROM=no-reply@example.org

# ── The school DID this deployment custodies (printed by create-school) ───────
SCHOOL_DID=
SCHOOL_HANDLE=boulder.freeskool.xyz
SCHOOL_APP_PASSWORD=
# Founding record values, used only by create-school.
SCHOOL_NAME=Boulder Free School
SCHOOL_REGION=Boulder, CO
SCHOOL_EMAIL=hello@freeskool.xyz

# ── Taxonomy authority (printed by `seed:skills`; see docs/deployment.md) ─────
# Today these live in /opt/freeskool/infra/production/.authority.env on the server, which
# is NOT read by the appview container — .env is. Add all three here (and recreate the
# appview container) or propose-a-skill answers 503 and the skill tree is unscoped.
AUTHORITY_DID=
AUTHORITY_HANDLE=
AUTHORITY_PASSWORD=

# ── AppView secrets ───────────────────────────────────────────────────────────
SESSION_SECRET=
CUSTODY_KEYS=v1:
CUSTODY_KEY_VERSION=v1
FEEDBACK_BALLOT_PEPPER=
# Optional. Unset, the AppView generates an ES256 key once and keeps it in Postgres.
OAUTH_PRIVATE_JWK=

# ── Federation / indexing ─────────────────────────────────────────────────────
PEER_PDS_HOSTS=https://pds.freeskool.xyz
CONTRAIL_NAMESPACE=org.freeschool.appview
CONTRAIL_ORDERED_SOURCE_EPOCH=freeschool-production-1
CONTRAIL_LIVE_INGEST=false
PEER_LIVE_SYNC=true

# ── Web push (web-push generate-vapid-keys) ───────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.org

# ── Email (REQUIRED in production; the AppView refuses to boot without SMTP_URL) ──
# Resend over SMTP: user `resend`, password = a sending-only API key. Port 2465 (not 465):
# Hetzner Cloud blocks outbound 25/465 on new accounts; Resend also listens on 2465/2587.
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:2465
MAIL_FROM=Free School <hello@example.org>
