{$WEB_HOST} {
  encode zstd gzip
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  @backend path /api/* /oauth/callback /oauth/jwks.json /oauth/client-metadata.json
  handle @backend {
    reverse_proxy appview:4000
  }
  handle {
    root * /srv
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    @static path /assets/* /fonts/*
    header @static Cache-Control "public, max-age=31536000, immutable"
    @sw path /sw.js /registerSW.js /index.html /manifest.webmanifest
    header @sw Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
