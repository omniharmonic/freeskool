# One Caddy for the whole stack. Four kinds of names:
#   {$WEB_HOST}                the PWA + the AppView API (same origin: cookies, OAuth)
#   www.{$WEB_HOST}            redirect to the apex (served from the wildcard block, see below)
#   {$PDS_HOST}                the PDS, whole: xrpc, oauth, admin, everything it serves
#   *.{$PDS_HANDLE_DOMAIN}     every handle host
#   *.{$SCHOOL_DOMAIN_SUFFIX}  every school host (`boulder.freeskool.xyz`) and www
#
# Those last two are ONE site block with two addresses, which is the whole trick. Before
# the neutral-hostname migration they are the same name (`freeskool.xyz`), and after it
# they are not (`freeskool.directory` and `freeskool.xyz`) — and Caddy refuses a duplicate
# site address across two blocks ("ambiguous site definition") while silently deduplicating
# identical addresses WITHIN one block. So one block with both, plus the legacy domain,
# serves every arrangement of those three variables without a conditional and without ever
# being able to collide. Verified with `caddy validate` in each arrangement; see
# docs/runbooks/pds-hostname-migration.md.
#
# `*.{$SCHOOL_DOMAIN_SUFFIX}` is PERMANENT. It is what keeps `boulder.freeskool.xyz` and
# `www.freeskool.xyz` answering after the migration is finished and the handle domain has
# moved away — without it, cleaning up the overlap would take the city app host and www
# down with it.
#
# `{$PDS_LEGACY_HOST}` exists only for the length of a hostname migration. A DID document
# is world-readable and slow to change; between the moment the PDS starts answering to
# `pds.freeskool.directory` and the moment the last account's PLC operation lands, some
# accounts still tell the network their repo is at `pds.freeskool.xyz`, and a client
# reading that document will dial it for `/xrpc/*` AND for OAuth. Unset, it falls back to
# a `.invalid` sentinel — a site block for a name that cannot resolve, which costs nothing.
#
# The wildcard inversion (multi-school design §3). A handle host needs the PDS for exactly
# two things — `/.well-known/atproto-did`, which is how the network resolves the handle, and
# `/xrpc/*`, which is how a client that discovered the handle first talks to the repo. Every
# OTHER path on such a host is the app, served exactly as the apex serves it (the `(app)`
# snippet below, imported by both). That is what lets `boulder.{$PDS_HANDLE_DOMAIN}` be the
# Boulder school's web address AND the Boulder school account's handle at the same time,
# instead of the collision the old "wildcard → PDS" block made of it.
#
# The cost is that a school label and a member handle share one namespace, so
# `apps/appview/src/lib/handles.ts` (`RESERVED_LABELS`) refuses to mint or accept a handle
# on a label a school could hold. Nothing here enforces that; it is enforced where handles
# are made.
#
# Why www lives inside the wildcard block: when a site lists both `*.example` and `www.example`,
# Caddy assumes the wildcard certificate will cover www and never issues one for it — but the
# wildcard here is on-demand (no DNS challenge), so www would never get a certificate at all.
# Instead www is issued on demand like a handle, through the local `ask` endpoint below.
#
# The ask endpoint now asks the AppView, not the PDS: the AppView knows www, it knows which
# labels are schools, and for anything else it asks the PDS itself. See
# `apps/appview/src/lib/tls-check.ts`. It stays container-local — 127.0.0.1 inside this
# container — and `/internal/*` is not routed from any public host, so nothing outside can
# reach it.
{
	on_demand_tls {
		ask http://127.0.0.1:9000/internal/tls-check
	}
}

# The app, as served on the apex and on every handle/school host. One definition, because
# "the same app on a different name" must not drift into two.
(app) {
	encode zstd gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}
	# Deliberately the three OAuth documents and not `/oauth/*`: `/oauth/confirm` is a
	# SCREEN in the PWA (`apps/web/src/router.tsx`), and handing it to the AppView would
	# 404 the second door.
	@backend path /api/* /oauth/callback /oauth/jwks.json /oauth/client-metadata.json
	handle @backend {
		reverse_proxy appview:4000
	}
	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		@static path /assets/* /fonts/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /registerSW.js /index.html /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$WEB_HOST} {
	import app
}

# The PDS's own hostname keeps the whole PDS. Its certificate stays on-demand, as it was
# when this name shared a block with the wildcard: a specific name Caddy believes a
# configured wildcard covers is never issued on its own.
{$PDS_HOST} {
	tls {
		on_demand
	}
	reverse_proxy pds:3000
}

# Every wildcard host — a member's handle, a school's web address, www — in ONE block,
# because two of these three addresses are the same name before the migration and a
# different name after it, and Caddy deduplicates identical addresses inside a block while
# refusing them across blocks. The order below is the order of specificity in the matchers,
# not of the names.
#
# A handle host needs the PDS for exactly two paths. Everything else is the app, served
# exactly as the apex serves it, which is what lets `boulder.freeskool.xyz` be the Boulder
# school's web address AND (until the migration) the school account's handle at once.
# Routing those two paths on a school host costs nothing once the handles have moved: the
# PDS simply has no account by that name and answers not-found, exactly as it does today
# for any label that is not a handle.
#
# CAVEAT, and it is the one thing to plan around: the on-demand `ask` gate
# (`apps/appview/src/lib/tls-check.ts`) vouches for exactly ONE handle domain — whichever
# `PDS_HANDLE_DOMAIN` currently is — plus the known school labels. During a migration,
# member handle hosts on the OTHER domain are served from certificates Caddy already holds;
# a name that has never been issued one cannot get one. That is why the runbook does the
# flip and the account migration in a single window rather than leaving the overlap open
# for days. School hosts and www are unaffected: the gate answers for those from
# `SCHOOL_LABELS` and `WEB_HOST`, neither of which this migration touches.
*.{$PDS_HANDLE_DOMAIN}, *.{$SCHOOL_DOMAIN_SUFFIX}, *.{$PDS_LEGACY_HANDLE_DOMAIN:legacy.invalid} {
	tls {
		on_demand
	}
	@www host www.{$WEB_HOST}
	redir @www https://{$WEB_HOST}{uri} permanent
	# The only two paths a handle host owes the network. Everything else falls through to
	# `import app` below — a school's PWA, or the same PWA on a member's handle host.
	@pds path /.well-known/atproto-did /xrpc/*
	handle @pds {
		reverse_proxy pds:3000
	}
	import app
}

# The PDS hostname we are moving AWAY from, for the length of the migration window only.
# Unset = a `.invalid` sentinel that never resolves. See the header.
{$PDS_LEGACY_HOST:legacy-pds.invalid} {
	tls {
		on_demand
	}
	reverse_proxy pds:3000
}

# Tributary (the events adapter + Boulder Directory console), a sibling compose stack on
# this box that joins this Caddy's network (see /opt/tributary/infra/production/compose.yml).
# One site, one upstream. Unset = a `.invalid` sentinel that never resolves. Its certificate
# is on-demand like the PDS host's, vouched for by the short-circuit in the ask gate below.
{$TRIBUTARY_HOST:tributary.invalid} {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy tributary:4100
}

# The on-demand "ask" gate (container-local only), proxied to the AppView, which answers
# `GET /internal/tls-check?domain=` with 200 (issue) or 403 (do not). A 403 — including a
# PDS that failed to answer — must never become a certificate.
http://127.0.0.1:9000 {
	# Our own PDS host and www never wait on the AppView: its check for an unknown host asks
	# the PDS over the public hostname, which needs this very certificate — a deadlock that
	# took production down on 2026-09-14 until this short-circuit was hot-fixed in place.
	@own query domain={$PDS_HOST}
	respond @own 200
	# The legacy PDS name during a hostname migration: DID documents still point at it.
	@legacy query domain={$PDS_LEGACY_HOST:legacy-pds.invalid}
	respond @legacy 200
	@www query domain=www.{$WEB_HOST}
	respond @www 200
	# Tributary's host (a sibling stack; see the site block above).
	@tributary query domain={$TRIBUTARY_HOST:tributary.invalid}
	respond @tributary 200
	reverse_proxy appview:4000
}
