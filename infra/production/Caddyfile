# One Caddy for the whole stack. Three kinds of names:
#   {$WEB_HOST}                          the PWA + the AppView API (same origin: cookies, OAuth)
#   www.{$WEB_HOST}                      redirect to the apex (served from the wildcard block, see below)
#   {$PDS_HOST}, *.{$PDS_HANDLE_DOMAIN}  the PDS, and every generated handle it answers for
#
# Why www lives inside the wildcard block: when a site lists both `*.example` and `www.example`,
# Caddy assumes the wildcard certificate will cover www and never issues one for it — but the
# wildcard here is on-demand (no DNS challenge), so www would never get a certificate at all.
# Instead www is issued on demand like a handle, through a local `ask` endpoint that says yes
# for www itself and defers to the PDS's /tls-check for everything else.
{
	on_demand_tls {
		ask http://127.0.0.1:9000/tls-check
	}
}

{$WEB_HOST} {
	encode zstd gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@backend path /api/* /oauth/callback /oauth/jwks.json /oauth/client-metadata.json
	handle @backend {
		reverse_proxy appview:4000
	}
	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		@static path /assets/* /fonts/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /registerSW.js /index.html /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$PDS_HOST}, *.{$PDS_HANDLE_DOMAIN} {
	tls {
		on_demand
	}
	@www host www.{$WEB_HOST}
	redir @www https://{$WEB_HOST}{uri} permanent
	reverse_proxy pds:3000
}

# The on-demand "ask" gate (container-local only). The PDS vouches for its own hostname and for
# every handle it has issued; www is the one extra name this stack answers for.
http://127.0.0.1:9000 {
	@www query domain=www.{$WEB_HOST}
	respond @www 200
	reverse_proxy pds:3000
}
