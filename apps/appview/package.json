{
  "name": "@freeschool/appview",
  "version": "0.0.1",
  "description": "Free School AppView \u2014 ATProto indexer, BFF/OAuth, app-side privacy tables, jobs.",
  "author": "Benjamin Life (@omniharmonic)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/lib/skill-tiers.seed.json dist/src/lib/skill-tiers.seed.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "create-school": "tsx scripts/create-school.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@atmo-dev/contrail": "0.23.0",
    "@atproto/api": "^0.20.44",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/oauth-client": "^0.8.7",
    "@atproto/oauth-client-node": "^0.5.7",
    "@freeschool/school-actor": "workspace:*",
    "@freeschool/shared": "workspace:*",
    "@freeschool/spaces-shim": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "nodemailer": "^10.0.9",
    "pg": "^8.16.3",
    "pg-boss": "^12.31.0",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
