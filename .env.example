# AppView
DATABASE_URL=postgres://freeschool:freeschool@localhost:5434/freeschool
APPVIEW_PORT=4000
APPVIEW_PUBLIC_URL=http://localhost:4000
# Our hosted PDS (for email signup that mints an account)
PDS_URL=http://localhost:3000
PDS_ADMIN_PASSWORD=see infra/pds.env
# The school DID the hosted service custodies in v1 (created by infra/seed/create-school.ts)
SCHOOL_DID=
SCHOOL_HANDLE=boulder.freeschool.localhost
SCHOOL_APP_PASSWORD=
# Peer registry (comma-separated PDS hosts to follow directly); the school record's `peers` field adds more
PEER_PDS_HOSTS=http://localhost:3000
# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.org
# Email
SMTP_URL=
# Web
VITE_APPVIEW_URL=http://localhost:4000
