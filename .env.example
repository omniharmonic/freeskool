# Free School — copy to `.env`, fill the blanks, then `set -a; . ./.env; set +a`.
# `apps/appview/src/config.ts` is the only thing that reads process.env; nothing loads
# .env for you. Every value below has a development default EXCEPT the four marked
# REQUIRED, which have no safe default.

# ── AppView ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://freeschool:freeschool@localhost:5434/freeschool
APPVIEW_PORT=4000
# This API's own origin. Only OAuth client metadata/jwks/callback live here.
APPVIEW_PUBLIC_URL=http://localhost:4000
# The PWA's origin. EVERY link a human clicks (magic link, invite, take-ownership,
# hand-off, .ics, unsubscribe) is built on this. Falls back to APPVIEW_PUBLIC_URL.
WEB_PUBLIC_URL=http://localhost:5173

# ── Our hosted PDS (the primary door mints accounts here) ──────────────────────
PDS_URL=http://localhost:3000
# REQUIRED for signup. The value in infra/pds.env (never commit that file).
PDS_ADMIN_PASSWORD=
# Handle domain for generated handles, no leading dot. `.localhost` is a reserved TLD
# the atproto syntax layer rejects — use `test` locally (see README §1).
PDS_HANDLE_DOMAIN=test

# ── The school DID the hosted service custodies in v1 ─────────────────────────
# All three are printed by `pnpm --filter @freeschool/appview create-school`.
SCHOOL_DID=
SCHOOL_HANDLE=boulder.test
SCHOOL_APP_PASSWORD=

# ── Federation ────────────────────────────────────────────────────────────────
# Comma-separated peer PDS hosts to follow directly; the school record's `peers` adds more.
PEER_PDS_HOSTS=http://localhost:3000
# Hosts allowed past contrail's SSRF guard (local/private PDSes only).
ALLOWED_PRIVATE_PDS_HOSTS=localhost,127.0.0.1,host.docker.internal

# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED, 16+ chars. Signs the session cookie; sessions themselves live in Postgres.
SESSION_SECRET=
# REQUIRED. Wraps custodial account passwords: `v1:<base64 of 32 random bytes>`
# (`node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Comma-separate to rotate: `v1:…,v2:…`.
CUSTODY_KEYS=
# Which CUSTODY_KEYS entry new wraps use. Must be present in CUSTODY_KEYS.
CUSTODY_KEY_VERSION=v1
# REQUIRED. Mixed into every per-event feedback ballot key before it is derived.
FEEDBACK_BALLOT_PEPPER=

# ── Web push (optional; reminders fall back to the in-app feed without it) ─────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.org

# ── Email ─────────────────────────────────────────────────────────────────────
# Unset locally: every mail is appended to apps/appview/.dev-mail.log (truncated at boot)
# instead of being sent. REQUIRED when NODE_ENV=production — the AppView refuses to boot
# without it, because the magic-link door cannot work and the file sink would write magic
# links to disk. Uncomment to use a real transport.
# SMTP_URL=smtp://user:pass@smtp.example.org:587
MAIL_FROM=Free School <no-reply@localhost>
